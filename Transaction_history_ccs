/* ===========================
   LAUNDRY KING — transaction-history.css
   Font: Satoshi (Fontshare)
   =========================== */

/* ── CSS Variables ── */
:root {
  --navy:        #1a3a6b;
  --navy-mid:    #2a4f8f;
  --navy-light:  #dce8f8;
  --bg:          #f0f2f5;
  --sidebar-bg:  #ffffff;
  --white:       #ffffff;
  --text-main:   #1a1a2e;
  --text-muted:  #6b7a99;
  --border:      #e2e8f4;
  --card-bg:     #ffffff;
  --active-bg:   #dce8f8;
  --active-text: #1a3a6b;
  --shadow-sm:   0 2px 8px rgba(26, 58, 107, 0.07);
  --shadow-md:   0 4px 16px rgba(26, 58, 107, 0.11);
  --radius-sm:   8px;
  --radius-md:   14px;
  --sidebar-w:   230px;
  --font:        'Satoshi', sans-serif;
}

/* ── Reset ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
}

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text-main);
  display: flex;
  min-height: 100vh;
}

ul {
  list-style: none;
}

button {
  cursor: pointer;
  font-family: var(--font);
  border: none;
  outline: none;
}

/* ===========================
   SIDEBAR
   =========================== */

.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 28px 16px 24px;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

/* Logo / Brand */
.sidebar__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 6px 28px;
}

.sidebar__brand {
  font-size: 17px;
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.3px;
}

/* Section label */
.sidebar__section-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 0 8px;
  margin-bottom: 6px;
}

/* Nav */
.sidebar__nav {
  margin-bottom: 8px;
}

.sidebar__nav--general {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}

/* Nav items */
.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  margin-bottom: 2px;
}

.nav-item svg {
  flex-shrink: 0;
  opacity: 0.7;
  transition: opacity 0.15s;
}

.nav-item:hover {
  background: var(--bg);
  color: var(--navy);
}

.nav-item:hover svg {
  opacity: 1;
}

.nav-item.active {
  background: var(--active-bg);
  color: var(--active-text);
  font-weight: 600;
}

.nav-item.active svg {
  opacity: 1;
}

/* ===========================
   MAIN CONTENT
   =========================== */

.main {
  margin-left: var(--sidebar-w);
  flex: 1;
  padding: 24px 32px 40px;
  min-height: 100vh;
}

/* ───── Topbar ───── */
.topbar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 24px;
}

.topbar__user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.topbar__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--navy-mid);
  color: var(--white);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}

.topbar__info {
  display: flex;
  flex-direction: column;
}

.topbar__name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.2;
}

.topbar__email {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
}

/* ───── Section ───── */
.section {
  margin-bottom: 32px;
}

.section__title {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border);
  letter-spacing: -0.2px;
}

/* ===========================
   TRANSACTION ITEMS
   =========================== */

.transactions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.transaction-item {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.18s, transform 0.15s;
}

.transaction-item:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

/* Icon bubble */
.transaction-item__icon {
  width: 48px;
  height: 48px;
  background: var(--navy-light);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Details (name + date) */
.transaction-item__details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.transaction-item__name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
}

.transaction-item__date {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
}

/* Right-side action area */
.transaction-item__action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  flex-shrink: 0;
}

.transaction-item__meta {
  font-size: 12.5px;
  color: var(--text-muted);
  font-weight: 500;
  white-space: nowrap;
}

.transaction-item__meta strong {
  color: var(--text-main);
  font-weight: 700;
}

/* Check Details button */
.btn-check-details {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  background: var(--navy);
  color: var(--white);
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  transition: background 0.15s, transform 0.12s;
}

.btn-check-details:hover {
  background: var(--navy-mid);
  transform: translateY(-1px);
}

.btn-check-details:active {
  transform: translateY(0);
}

/* ===========================
   RESPONSIVE
   =========================== */

@media (max-width: 768px) {
  :root {
    --sidebar-w: 0px;
  }

  .sidebar {
    display: none;
  }

  .main {
    margin-left: 0;
    padding: 16px 16px 32px;
  }

  .transaction-item {
    flex-wrap: wrap;
  }

  .transaction-item__action {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
}