<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Laundry King — Pick up & Delivery</title>
  <link rel="stylesheet" href="pickup-delivery.css" />
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ===== SIDEBAR ===== -->
  <aside class="sidebar">
    <div class="sidebar__logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="3" width="22" height="22" rx="4" stroke="#1a3a6b" stroke-width="2"/>
        <circle cx="14" cy="15" r="6" stroke="#1a3a6b" stroke-width="2"/>
        <circle cx="14" cy="15" r="2.5" stroke="#1a3a6b" stroke-width="1.5"/>
        <circle cx="8" cy="7.5" r="1.2" fill="#1a3a6b"/>
        <circle cx="11.5" cy="7.5" r="1.2" fill="#1a3a6b"/>
      </svg>
      <span class="sidebar__brand">Laundry King</span>
    </div>

    <nav class="sidebar__nav">
      <p class="sidebar__section-label">Menu</p>
      <ul>
        <li class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Home
        </li>
        <li class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Transaction History
        </li>
        <li class="nav-item active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Offered Services
        </li>
        <li class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><polyline points="8 21 12 17 16 21"/></svg>
          Laundry Status
        </li>
      </ul>
    </nav>

    <nav class="sidebar__nav sidebar__nav--general">
      <p class="sidebar__section-label">General</p>
      <ul>
        <li class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
          Settings
        </li>
        <li class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Profile
        </li>
        <li class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Log Out
        </li>
      </ul>
    </nav>
  </aside>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="main">

    <!-- No topbar user shown in this design, but keeping consistent -->
    <header class="topbar">
      <div class="topbar__spacer"></div>
    </header>

    <!-- Address card -->
    <div class="address-card">
      <div class="address-card__left">
        <div class="address-card__label">
          <!-- Pin icon -->
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1a3a6b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Your address</span>
        </div>
        <p class="address-card__text">8FHJ+24C, National Hwy, Kalayaan, Laguna, 8FHJ+24C, National Hwy, Kalayaan, Laguna</p>
      </div>
      <button class="address-card__arrow" aria-label="Edit address">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3a6b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    </div>

    <!-- Pick up & Delivery -->
    <section class="section">
      <h2 class="section__title">Pick up &amp; Delivery</h2>
      <div class="toggle-grid">
        <button class="toggle-btn selected" onclick="selectToggle(this, 'delivery')">Delivery</button>
        <button class="toggle-btn"          onclick="selectToggle(this, 'delivery')">Pick up</button>
      </div>
    </section>

    <!-- Payment Methods -->
    <section class="section">
      <h2 class="section__title">Payment Methods</h2>
      <div class="toggle-grid">
        <button class="toggle-btn selected" onclick="selectToggle(this, 'payment')">Online Payment</button>
        <button class="toggle-btn"          onclick="selectToggle(this, 'payment')">Cash on pick up/delivery</button>
      </div>
    </section>

    <!-- Bottom actions -->
    <div class="bottom-actions">
      <button class="btn-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
      </button>
      <button class="btn-next">
        Next
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </div>

  </main>

  <script>
    function selectToggle(btn, group) {
      const parent = btn.closest('.toggle-grid');
      parent.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
    }
  </script>

</body>
</html>