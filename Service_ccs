/* ===========================
   LAUNDRY KING — offered-services.css
   Font: Satoshi (Fontshare)
   =========================== */

/* ── CSS Variables ── */
:root {
  --navy:        #1a3a6b;
  --navy-mid:    #2a4f8f;
  --navy-light:  #dce8f8;
  --bg:          #f0f2f5;
  --sidebar-bg:  #ffffff;
  --white:       #ffffff;
  --text-main:   #1a1a2e;
  --text-muted:  #6b7a99;
  --border:      #e2e8f4;
  --card-bg:     #ffffff;
  --active-bg:   #dce8f8;
  --active-text: #1a3a6b;
  --selected-border: #1a3a6b;
  --shadow-sm:   0 2px 8px rgba(26, 58, 107, 0.07);
  --shadow-md:   0 4px 16px rgba(26, 58, 107, 0.13);
  --radius-sm:   8px;
  --radius-md:   14px;
  --sidebar-w:   230px;
  --font:        'Satoshi', sans-serif;
}

/* ── Reset ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
}

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text-main);
  display: flex;
  min-height: 100vh;
}

ul {
  list-style: none;
}

button {
  cursor: pointer;
  font-family: var(--font);
  border: none;
  outline: none;
}

/* ===========================
   SIDEBAR
   =========================== */

.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 28px 16px 24px;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

.sidebar__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 6px 28px;
}

.sidebar__brand {
  font-size: 17px;
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.3px;
}

.sidebar__section-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 0 8px;
  margin-bottom: 6px;
}

.sidebar__nav {
  margin-bottom: 8px;
}

.sidebar__nav--general {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  margin-bottom: 2px;
}

.nav-item svg {
  flex-shrink: 0;
  opacity: 0.7;
  transition: opacity 0.15s;
}

.nav-item:hover {
  background: var(--bg);
  color: var(--navy);
}

.nav-item:hover svg {
  opacity: 1;
}

.nav-item.active {
  background: var(--active-bg);
  color: var(--active-text);
  font-weight: 600;
}

.nav-item.active svg {
  opacity: 1;
}

/* ===========================
   MAIN CONTENT
   =========================== */

.main {
  margin-left: var(--sidebar-w);
  flex: 1;
  padding: 24px 32px 100px;
  min-height: 100vh;
  position: relative;
}

/* ───── Topbar ───── */
.topbar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 24px;
}

.topbar__user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.topbar__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--navy-mid);
  color: var(--white);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}

.topbar__info {
  display: flex;
  flex-direction: column;
}

.topbar__name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.2;
}

.topbar__email {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
}

/* ───── Section ───── */
.section {
  margin-bottom: 32px;
}

.section__title {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border);
  letter-spacing: -0.2px;
}

.optional {
  font-weight: 500;
  color: var(--text-muted);
  font-size: 14px;
}

/* ===========================
   SERVICE CARDS
   =========================== */

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  max-width: 700px;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  max-width: 700px;
}

.service-card {
  background: var(--card-bg);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px 18px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.18s, box-shadow 0.18s, transform 0.15s;
  user-select: none;
}

.service-card:hover {
  border-color: #a8c4e8;
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.service-card.selected {
  border-color: var(--selected-border);
  box-shadow: 0 0 0 1px var(--navy), var(--shadow-md);
}

/* Icon bubble */
.service-card__icon {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--navy-light);
  border-radius: var(--radius-sm);
}

/* Text content */
.service-card__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-top: 4px;
}

.service-card__info h3 {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
}

.service-card__price {
  font-size: 14px;
  font-weight: 600;
  color: var(--navy);
}

.service-card__desc {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
  line-height: 1.5;
}

/* ===========================
   BOTTOM ACTIONS
   =========================== */

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: var(--sidebar-w);
  right: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 16px 32px;
  background: var(--bg);
  border-top: 1px solid var(--border);
}

.btn-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  background: transparent;
  color: var(--navy);
  border: 1.5px solid var(--navy);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  transition: background 0.15s, color 0.15s;
}

.btn-back:hover {
  background: var(--navy-light);
}

.btn-next {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 28px;
  background: var(--navy);
  color: var(--white);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  transition: background 0.15s, transform 0.12s;
}

.btn-next:hover {
  background: var(--navy-mid);
  transform: translateY(-1px);
}

.btn-next:active {
  transform: translateY(0);
}

/* ===========================
   RESPONSIVE
   =========================== */

@media (max-width: 768px) {
  :root {
    --sidebar-w: 0px;
  }

  .sidebar {
    display: none;
  }

  .main {
    margin-left: 0;
    padding: 16px 16px 90px;
  }

  .service-grid,
  .type-grid {
    grid-template-columns: 1fr;
    max-width: 100%;
  }

  .bottom-actions {
    left: 0;
    padding: 14px 16px;
  }
}