/* ===========================
   LAUNDRY KING — style.css
   Font: Satoshi (Fontshare)
   =========================== */

/* ── CSS Variables ── */
:root {
  --navy:        #1a3a6b;
  --navy-mid:    #2a4f8f;
  --navy-light:  #dce8f8;
  --accent:      #1a3a6b;
  --bg:          #f0f2f5;
  --sidebar-bg:  #ffffff;
  --white:       #ffffff;
  --text-main:   #1a1a2e;
  --text-muted:  #6b7a99;
  --border:      #e2e8f4;
  --card-bg:     #ffffff;
  --active-bg:   #dce8f8;
  --active-text: #1a3a6b;
  --shadow-sm:   0 2px 8px rgba(26, 58, 107, 0.07);
  --shadow-md:   0 4px 16px rgba(26, 58, 107, 0.11);
  --radius-sm:   8px;
  --radius-md:   14px;
  --radius-lg:   20px;
  --sidebar-w:   230px;
  --font:        'Satoshi', sans-serif;
}

/* ── Reset ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
}

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text-main);
  display: flex;
  min-height: 100vh;
}

ul {
  list-style: none;
}

button {
  cursor: pointer;
  font-family: var(--font);
  border: none;
  outline: none;
}

/* ===========================
   SIDEBAR
   =========================== */

.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 28px 16px 24px;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

/* Logo / Brand */
.sidebar__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 6px 28px;
}

.sidebar__brand {
  font-size: 17px;
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.3px;
}

/* Section label */
.sidebar__section-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 0 8px;
  margin-bottom: 6px;
}

/* Nav */
.sidebar__nav {
  margin-bottom: 8px;
}

.sidebar__nav--general {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}

/* Nav items */
.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  margin-bottom: 2px;
}

.nav-item svg {
  flex-shrink: 0;
  opacity: 0.7;
  transition: opacity 0.15s;
}

.nav-item:hover {
  background: var(--bg);
  color: var(--navy);
}

.nav-item:hover svg {
  opacity: 1;
}

.nav-item.active {
  background: var(--active-bg);
  color: var(--active-text);
  font-weight: 600;
}

.nav-item.active svg {
  opacity: 1;
}

/* ===========================
   MAIN CONTENT
   =========================== */

.main {
  margin-left: var(--sidebar-w);
  flex: 1;
  padding: 24px 32px 40px;
  min-height: 100vh;
}

/* ───── Topbar ───── */
.topbar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 20px;
}

.topbar__user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.topbar__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--navy-mid);
  color: var(--white);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}

.topbar__info {
  display: flex;
  flex-direction: column;
}

.topbar__name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.2;
}

.topbar__email {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
}

/* ───── Hero ───── */
.hero {
  position: relative;
  width: 100%;
  height: 200px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 32px;
  /* Laundry-themed gradient as background */
  background: linear-gradient(135deg, #1a3a6b 0%, #2a6bb5 50%, #4fa3d1 100%);
  display: flex;
  align-items: flex-end;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(10, 25, 60, 0.75) 0%,
    rgba(10, 25, 60, 0.35) 60%,
    rgba(10, 25, 60, 0.10) 100%
  );
}

/* Decorative circles to simulate washing machine look */
.hero::before,
.hero::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.12);
}

.hero::before {
  width: 260px;
  height: 260px;
  right: -40px;
  top: -40px;
}

.hero::after {
  width: 180px;
  height: 180px;
  right: 20px;
  top: 10px;
  border-color: rgba(255, 255, 255, 0.08);
}

.hero__content {
  position: relative;
  z-index: 1;
  padding: 0 28px 24px;
  color: var(--white);
}

.hero__content h1 {
  font-size: 26px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.5px;
  margin-bottom: 6px;
}

.hero__content p {
  font-size: 13px;
  font-weight: 400;
  opacity: 0.85;
}

/* ───── Section ───── */
.section {
  margin-bottom: 32px;
}

.section__title {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border);
  letter-spacing: -0.2px;
}

/* ───── Service Cards ───── */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.service-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 18px 16px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.18s, transform 0.18s;
  cursor: pointer;
}

.service-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.service-card__icon {
  flex-shrink: 0;
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--navy-light);
  border-radius: var(--radius-sm);
}

.service-card__info h3 {
  font-size: 14px;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 6px;
}

.service-card__info p {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
  line-height: 1.6;
}

/* ───── Purchase Items ───── */
.purchases {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.purchase-item {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.18s;
}

.purchase-item:hover {
  box-shadow: var(--shadow-md);
}

.purchase-item__icon {
  width: 44px;
  height: 44px;
  background: var(--navy-light);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.purchase-item__details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.purchase-item__name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
}

.purchase-item__date {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 400;
}

.purchase-item__action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  flex-shrink: 0;
}

.purchase-item__ref {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 500;
}

.btn-check-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  background: var(--navy);
  color: var(--white);
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  transition: background 0.15s, transform 0.12s;
  white-space: nowrap;
}

.btn-check-status:hover {
  background: var(--navy-mid);
  transform: translateY(-1px);
}

.btn-check-status:active {
  transform: translateY(0);
}

/* ===========================
   RESPONSIVE
   =========================== */

@media (max-width: 1024px) {
  .cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  :root {
    --sidebar-w: 0px;
  }

  .sidebar {
    display: none;
  }

  .main {
    margin-left: 0;
    padding: 16px 16px 32px;
  }

  .cards-grid {
    grid-template-columns: 1fr;
  }

  .purchase-item {
    flex-wrap: wrap;
  }

  .purchase-item__action {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .hero__content h1 {
    font-size: 20px;
  }
}