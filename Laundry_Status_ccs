/* ===========================
   LAUNDRY KING — laundry-status.css
   Font: Satoshi (Fontshare)
   =========================== */

:root {
  --navy:        #1a3a6b;
  --navy-mid:    #2a4f8f;
  --navy-light:  #dce8f8;
  --bg:          #f0f2f5;
  --sidebar-bg:  #ffffff;
  --white:       #ffffff;
  --text-main:   #1a1a2e;
  --text-muted:  #6b7a99;
  --border:      #e2e8f4;
  --card-bg:     #ffffff;
  --active-bg:   #dce8f8;
  --active-text: #1a3a6b;
  --shadow-sm:   0 2px 8px rgba(26, 58, 107, 0.07);
  --shadow-md:   0 4px 16px rgba(26, 58, 107, 0.13);
  --radius-sm:   8px;
  --radius-md:   14px;
  --sidebar-w:   230px;
  --font:        'Satoshi', sans-serif;

  /* tracker */
  --step-inactive-bg:    #edf2f9;
  --step-inactive-color: #8fa5c8;
  --step-active-bg:      #3a6bbf;
  --step-active-color:   #ffffff;
  --connector-inactive:  #d0dcea;
  --connector-active:    #3a6bbf;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text-main);
  display: flex;
  min-height: 100vh;
}

ul  { list-style: none; }
button { cursor: pointer; font-family: var(--font); border: none; outline: none; }

/* ===========================
   SIDEBAR
   =========================== */

.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 28px 16px 24px;
  position: fixed;
  top: 0; left: 0; bottom: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

.sidebar__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 6px 28px;
}

.sidebar__brand {
  font-size: 17px;
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.3px;
}

.sidebar__section-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 0 8px;
  margin-bottom: 6px;
}

.sidebar__nav { margin-bottom: 8px; }

.sidebar__nav--general {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  margin-bottom: 2px;
}

.nav-item svg { flex-shrink: 0; opacity: 0.7; transition: opacity 0.15s; }
.nav-item:hover { background: var(--bg); color: var(--navy); }
.nav-item:hover svg { opacity: 1; }
.nav-item.active { background: var(--active-bg); color: var(--active-text); font-weight: 600; }
.nav-item.active svg { opacity: 1; }

/* ===========================
   MAIN
   =========================== */

.main {
  margin-left: var(--sidebar-w);
  flex: 1;
  padding: 24px 32px 100px;
  min-height: 100vh;
}

/* Topbar */
.topbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20px;
}

.topbar__user { display: flex; align-items: center; gap: 10px; }

.topbar__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--navy-mid);
  color: var(--white);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topbar__info { display: flex; flex-direction: column; }
.topbar__name  { font-size: 14px; font-weight: 600; color: var(--text-main); line-height: 1.2; }
.topbar__email { font-size: 12px; color: var(--text-muted); font-weight: 400; }

/* Section */
.section { margin-bottom: 28px; }

.section__title {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border);
  letter-spacing: -0.2px;
}

/* ===========================
   STATUS TRACKER
   =========================== */

.status-tracker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 16px 0 28px;
}

/* Each step */
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.step__circle {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  background: var(--step-inactive-bg);
  color: var(--step-inactive-color);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--connector-inactive);
  transition: background 0.3s, color 0.3s, border-color 0.3s;
}

.step.active .step__circle {
  background: var(--step-active-bg);
  color: var(--step-active-color);
  border-color: var(--step-active-bg);
  box-shadow: 0 4px 18px rgba(58, 107, 191, 0.30);
}

.step__label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: -0.1px;
}

.step.active .step__label {
  color: var(--navy);
}

/* Connector line between steps */
.step__connector {
  flex: 1;
  height: 3px;
  background: var(--connector-inactive);
  min-width: 40px;
  max-width: 120px;
  margin-bottom: 26px; /* align with circle centers */
}

/* ===========================
   ORDER CARD
   =========================== */

.order-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 24px 28px 28px;
  box-shadow: var(--shadow-sm);
}

.order-card__number {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}

.order-details {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.detail-row {
  display: flex;
  gap: 8px;
}

.detail-row__key {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
  min-width: 190px;
  flex-shrink: 0;
}

.detail-row__val {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-main);
}

/* Inline badges */
.status-badge {
  display: inline-block;
  background: #fff3cd;
  color: #7a5800;
  border-radius: 20px;
  padding: 2px 10px;
  font-size: 12px;
  font-weight: 600;
}

.paid-badge {
  display: inline-block;
  background: #d4edda;
  color: #155724;
  border-radius: 20px;
  padding: 2px 10px;
  font-size: 12px;
  font-weight: 600;
}

/* ===========================
   BOTTOM ACTIONS
   =========================== */

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: var(--sidebar-w);
  right: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 16px 32px;
  background: var(--bg);
  border-top: 1px solid var(--border);
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 32px;
  background: var(--navy);
  color: var(--white);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  transition: background 0.15s, transform 0.12s;
}

.btn-primary:hover { background: var(--navy-mid); transform: translateY(-1px); }
.btn-primary:active { transform: translateY(0); }

/* ===========================
   RESPONSIVE
   =========================== */

@media (max-width: 900px) {
  .step__circle { width: 70px; height: 70px; }
  .step__circle svg { width: 32px; height: 32px; }
  .step__connector { max-width: 60px; min-width: 20px; }
  .detail-row__key { min-width: 150px; }
}

@media (max-width: 768px) {
  :root { --sidebar-w: 0px; }
  .sidebar { display: none; }
  .main { margin-left: 0; padding: 16px 16px 90px; }
  .bottom-actions { left: 0; padding: 14px 16px; }
  .detail-row { flex-direction: column; gap: 2px; }
  .detail-row__key { min-width: unset; }
  .step__connector { min-width: 16px; }
  .order-card { padding: 18px 16px; }
}